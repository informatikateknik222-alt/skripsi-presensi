{
  "name": "skripsi-presensi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "description": "Monorepo root untuk Skripsi Presensi",
  "scripts": {
    "dev": "concurrently -k \"yarn workspace api start:employee\" \"yarn workspace api start:attendance\" \"yarn workspace api start:payroll\" \"yarn workspace web dev\"",
    "start:employee": "yarn workspace api start:employee",
    "start:attendance": "yarn workspace api start:attendance",
    "start:payroll": "yarn workspace api start:payroll",
    "start:web": "yarn workspace web dev",
    "watch-push": "node watch-and-push.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
